{
  "name": "spine-framework",
  "version": "0.5.0-rc.6",
  "description": "Multi-tenant, modular application platform for modern SaaS systems",
  "type": "module",
  "bin": {
    "spine-framework": "bin/spine-framework.cjs"
  },
  "files": [
    "bin/",
    "scripts/assemble.sh",
    "scripts/assemble-frontend.sh",
    "scripts/assemble-functions.sh",
    "scripts/dev-netlify.sh",
    "scripts/dev-clean.sh",
    "scripts/netlify-dev-wrapper.sh",
    "scripts/verify-integrity.sh",
    "scripts/build-manifest.sh",
    "scripts/checksum-manifest.mts",
    "scripts/verify-manifest.mts",
    "scripts/boundary-check.sh",
    "scripts/verify-install.ts",
    "templates/project/",
    "config/",
    "!config/*.tsbuildinfo",
    "!config/deno.lock",
    "!config/package-lock.json",
    "vitest.config.ts",
    "netlify.toml",
    ".env.example",
    ".framework/",
    "!.framework/mcp/",
    "!.framework/migrations/archive/",
    "!.framework/functions/_quarantine/",
    "!.framework/tests/integration/",
    "!.framework/public/spine.config.json",
    "!.framework/docs/admin-routes.md",
    "!.framework/docs/api-docs-progress.md",
    "!.framework/docs/api-governance.md",
    "!.framework/docs/api-testing-results.md",
    "!.framework/docs/assembly-launch-guide.md",
    "!.framework/docs/audit-results.md",
    "!.framework/docs/db-api-inventory.md",
    "!.framework/docs/gap-remediation-backlog.md",
    "!.framework/docs/ui-adoption-verification.md",
    "!.framework/docs/ui-api-coverage.md",
    "!.framework/docs/v2-compatibility-audit.md",
    "!**/*.tsbuildinfo",
    "!**/.DS_Store",
    "!**/.env",
    "!**/.env.local",
    "!**/.env.production",
    "!**/.env.development",
    "!**/.env.test",
    "!**/.xenv",
    "!**/.xenv.*",
    "README.md",
    "LICENSE.md"
  ],
  "keywords": [
    "spine",
    "framework",
    "multi-tenant",
    "saas",
    "supabase",
    "react",
    "typescript"
  ],
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spine-framework/spine-framework.git"
  },
  "homepage": "https://spine-framework.com",
  "bugs": {
    "url": "https://github.com/spine-framework/spine-framework/issues"
  },
  "scripts": {
    "spine-framework": "tsx .framework/cli/index.ts",
    "dev": "vite --config config/vite.config.ts",
    "dev:netlify": "bash scripts/dev-netlify.sh",
    "dev:stop": "bash scripts/dev-clean.sh",
    "assemble": "bash scripts/assemble.sh",
    "assemble:frontend": "bash scripts/assemble-frontend.sh",
    "assemble:functions": "bash scripts/assemble-functions.sh",
    "manifest": "bash scripts/build-manifest.sh",
    "verify": "bash scripts/verify-integrity.sh",
    "prebuild": "npm run assemble && npm run verify",
    "build": "vite build --config config/vite.config.ts",
    "preview": "vite preview --config config/vite.config.ts",
    "lint": "eslint .",
    "app-install": "tsx scripts/app-install-cli.ts",
    "load-test": "tsx scripts/load-test-app-install.ts",
    "test": "vitest run",
    "test:unit": "vitest run .framework/tests/unit",
    "test:core": "vitest run .framework/tests/unit/core-isolation.test.ts",
    "test:integration": "vitest run .framework/tests/integration",
    "test:boundary": "bash scripts/boundary-check.sh",
    "docs": "typedoc --entryPoints .framework/functions/_shared/index.ts --out docs/generated",
    "docs:lint": "tsx scripts/docs-lint.mts",
    "prepack": "node custom/npm/scripts/prepack-framework.mjs stage",
    "postpack": "node custom/npm/scripts/prepack-framework.mjs clean",
    "cil:migrate-markers": "tsx .framework/scripts/cil-migrate-markers.ts",
    "typecheck": "tsc -b config/tsconfig.json",
    "typecheck:functions": "tsc --noEmit -p config/tsconfig.functions.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@heroicons/react": "^2.2.0",
    "@marsidev/react-turnstile": "^1.1.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@supabase/supabase-js": "^2.49.1",
    "@tanstack/react-query": "^5.95.2",
    "@tiptap/extension-code-block-lowlight": "^3.20.0",
    "@tiptap/extension-image": "^3.20.0",
    "@tiptap/extension-link": "^3.20.0",
    "@tiptap/extension-placeholder": "^3.20.0",
    "@tiptap/extension-table": "^3.20.0",
    "@tiptap/extension-table-cell": "^3.20.0",
    "@tiptap/extension-table-header": "^3.20.0",
    "@tiptap/extension-table-row": "^3.20.0",
    "@tiptap/extension-youtube": "^3.20.0",
    "@tiptap/pm": "^3.20.0",
    "@tiptap/react": "^3.20.0",
    "@tiptap/starter-kit": "^3.20.0",
    "@types/react-grid-layout": "^1.3.6",
    "@xyflow/react": "^12.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "commander": "^12.0.0",
    "dagre": "^0.8.5",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.13",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.34.3",
    "github-markdown-css": "^5.9.0",
    "highlight.js": "^11.11.1",
    "input-otp": "^1.4.2",
    "jsonwebtoken": "^9.0.3",
    "jwt-decode": "^4.0.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.14.0",
    "marked": "^17.0.3",
    "mermaid": "^11.12.3",
    "next-themes": "^0.4.6",
    "pg": "^8.13.0",
    "radix-ui": "^1.4.3",
    "react": "^18.3.1",
    "react-day-picker": "^10.0.0",
    "react-dom": "^18.3.1",
    "react-grid-layout": "^2.2.2",
    "react-is": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.11.0",
    "react-router-dom": "^6.28.1",
    "recharts": "3.8.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "tiptap-markdown": "^0.9.0",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.6.2",
    "vaul": "^1.1.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@netlify/functions": "^2.8.2",
    "@supabase/supabase-js": "^2.49.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.12.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "ajv": "^8.12.0",
    "autoprefixer": "^10.4.20",
    "js-yaml": "^4.1.0",
    "netlify-cli": "27.8.0",
    "postcss": "^8.5.1",
    "react-refresh": "^0.14.0",
    "tailwindcss": "^3.4.17",
    "typedoc": "^0.27.0",
    "vite": "^6.0.11",
    "vitest": "^2.1.9"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
