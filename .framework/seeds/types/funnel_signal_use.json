        "update",
        "delete"
      ],
      "support_admin": [
        "create",
        "read",
        "update"
      ],
      "support": [
        "create",
        "read",
        "update"
      ],
      "member_admin": [
        "create",
        "read",
        "update"
      ],
      "member": [
        "create",
        "read",
        "update"
      ]
    }
  },
  "validation_schema": {},
  "ownership": "pack",
  "is_active": true
}
