{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://spine-framework.dev/schemas/spine.config.schema.json",
  "title": "Spine Framework instance config",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "branding": {
      "type": "object",
      "additionalProperties": false,
      "description": "Instance branding applied to framework-owned pages (login, register, setup, sidebars) plus document.title and favicon. All keys optional; absent block falls back to Spine defaults.",
      "properties": {
        "app_name": {
          "type": "string",
          "description": "Display name used in headings and logo alt text, e.g. 'Answer Once'"
        },
        "title": {
          "type": "string",
          "description": "document.title and sidebar wordmark; defaults to app_name"
        },
        "logo_url": {
          "type": "string",
          "description": "Public asset path for the brand logo, e.g. '/answer-once-logo.svg'"
        },
        "favicon_url": {
          "type": "string",
          "description": "Public asset path swapped into link[rel=icon] at runtime"
        }
      }
    },
    "brands": {
      "type": "object",
      "additionalProperties": true,
      "description": "Multi-brand map: by_host resolves hostname → brand slug, definitions holds per-brand identity (name/title/site_url/logo_url/favicon_url/email_logo_url/email_from), default is the fallback slug. Flat 'branding' remains the base for hosts with no brand entry.",
      "properties": {
        "default": { "type": "string" },
        "by_host": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "definitions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "name": { "type": "string" },
              "app_name": { "type": "string" },
              "title": { "type": "string" },
              "site_url": { "type": "string" },
              "logo_url": { "type": "string" },
              "favicon_url": { "type": "string" },
              "email_logo_url": { "type": "string" },
              "email_from": { "type": "string" }
            }
          }
        }
      }
    },
    "registration": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "default_app": { "type": "string" },
        "default_role": { "type": "string" },
        "allow_url_override": { "type": "boolean" },
        "default_app_by_role": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "apps": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "roles": { "type": "array", "items": { "type": "string" } },
              "default_role": { "type": "string" },
              "path": { "type": "string" },
              "enabled": { "type": "boolean" },
              "account_strategy": { "type": "string", "enum": ["new", "existing"] },
              "parent_account": { "type": "string" },
              "target_account": { "type": "string" },
              "allow_domain_join": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
