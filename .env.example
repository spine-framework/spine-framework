# ── Branding ──────────────────────────────────────────────────────
# App name shown in UI, page title, localStorage keys, webhook headers
VITE_APP_NAME=Spine

# Environment badge shown in the UI (dev, staging, prod)
VITE_ENVIRONMENT=dev

# ── Supabase (frontend — public keys only) ───────────────────────
# All values in both Supabase blocks come from one page:
#   Supabase Dashboard → Project Settings → API Keys
#   (older dashboards: Settings → API / Data API)
# Key naming: the "Publishable key" (sb_publishable_…) is the anon key, and
# a "Secret key" (sb_secret_…) is the service-role key. Legacy anon /
# service_role JWTs work identically — use whichever your project shows.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-or-publishable-key

# ── Supabase (backend — Netlify Functions) ───────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
# Functions build user-scoped PostgREST clients with the anon key.
SUPABASE_ANON_KEY=your-anon-key-or-publishable-key

# ── Migrations / CLI ─────────────────────────────────────────────
# Postgres password used by `spine-framework migrate` and `install-app`
# (connects directly to db.<project-ref>.supabase.co:5432).
# Get from: Supabase Dashboard → Project Settings → Database.
SUPABASE_DB_PASSWORD=
# Alternative to SUPABASE_DB_PASSWORD: a full Postgres connection string.
# Use the Session Pooler host when your network can't reach db.<ref>.supabase.co:5432
# (direct connections are IPv6-only on most Supabase projects).
# SUPABASE_DB_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── App URLs ─────────────────────────────────────────────────────
# Base URL for invite links and auth redirects; also the allowlist
# origin for client-supplied base_url params.
APP_BASE_URL=http://localhost:8888

# ── Database Schema (advanced / multi-instance) ────────────────
# Default installs run in the public schema. Only set these
# if you intentionally deploy the deprecated namespaced installer
# (see SETUP.md "Advanced: multi-instance" section).
# VITE_DB_SCHEMA=
# DB_SCHEMA=

# ── CORS / Security ─────────────────────────────────────────────
# Your production site URL (used for CORS Allow-Origin header).
# Netlify auto-sets URL; override with SITE_URL if using a custom domain.
# SITE_URL=https://your-custom-domain.com

# Cloudflare Turnstile site key (public — safe to ship to the browser).
# When set, the Register/Login/ForgotPassword pages render a Turnstile
# widget and pass its token to Supabase Auth. Pair it with the secret key
# configured in Supabase Dashboard → Authentication → Bot and Abuse
# Protection. Use one Turnstile site covering both your prod domain and
# `localhost` so the same key works in local dev.
# VITE_TURNSTILE_SITE_KEY=

# Netlify API credentials used by the security admin function to push
# banned IPs into the site's edge Firewall Traffic Rules. Create a
# Personal Access Token in Netlify → User Settings → Applications.
# Leave unset to skip the edge layer (Supabase ban + internal blocklist
# still apply).
# NETLIFY_ACCESS_TOKEN=
# NETLIFY_SITE_ID=

# Shared secret required in the `x-internal-secret` header for any request
# to be treated as a cron/trigger machine principal (x-cron-id/x-trigger-id
# headers). Generate with `openssl rand -hex 32`. Leave unset to disable
# these header-based principals entirely (default; nothing sets them today).
# INTERNAL_INVOKE_SECRET=

# Shared secret for the system-cron scheduler endpoint (?api_key= or
# ?scheduler_key= query param). Generate with `openssl rand -hex 32`.
# SCHEDULER_API_KEY=

# ── AI (optional) ───────────────────────────────────────────────
# Required for AI-powered workflow actions (ai_prompt action type)
# OPENAI_API_KEY=sk-...

# ── Email (optional) ────────────────────────────────────────────
# Resend API key for the 'transactional-email' integration (invites and
# ticket-reply notifications). Until this is set, invites fall back to
# copyable links and email notification stages skip silently.
# RESEND_API_KEY=re_...
# Sender identity for outbound email (e.g. 'Answer Once <noreply@yourdomain.com>').
# Requires the domain to be verified in Resend; falls back to onboarding@resend.dev.
# EMAIL_FROM=noreply@yourdomain.com
# EMAIL_WEBHOOK_URL=https://hook.us1.make.com/your-scenario-id
